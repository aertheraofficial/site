NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin used for links that leave the building (receipt links sent by WhatsApp
# or email). Only needed when NEXT_PUBLIC_SITE_URL is localhost — a customer
# cannot open a localhost receipt. Defaults to https://www.aerthera.com.
PUBLIC_SITE_URL=

# ToyyibPay — https://toyyibpay.com (Dashboard > Profile > Secret Key)
TOYYIBPAY_SECRET_KEY=
# ToyyibPay Category Code (Dashboard > Category > Create Category)
TOYYIBPAY_CATEGORY_CODE=

STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET_TEST=whsec_your_test_webhook_secret
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase public keys (for customer auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STRIPE_ENABLE_AUTOMATIC_TAX=false
STRIPE_ALLOWED_SHIPPING_COUNTRIES=MY,SG,TH,ID,BN,PH,VN,AU,NZ,GB,US
STRIPE_SHIPPING_STANDARD_LABEL=Standard Shipping
STRIPE_SHIPPING_STANDARD_AMOUNT=0
STRIPE_SHIPPING_EXPRESS_LABEL=Express Shipping
STRIPE_SHIPPING_EXPRESS_AMOUNT=
ORDER_STORAGE_PATH=./data/orders.json
SOCIAL_STORAGE_PATH=./data/social-content.json

# --- Receipts -------------------------------------------------------------
# PDF receipt is emailed to the customer automatically once payment is confirmed.
# Without RESEND_API_KEY the receipt is skipped (logged, never blocks checkout).
# Resend — https://resend.com (API Keys). The sending domain must be verified.
RESEND_API_KEY=
# Must use a Resend-verified domain, e.g. "Aerthera <hello@aerthera.com>"
RECEIPT_FROM_EMAIL=
# SST is OFF by default. Turn on only if Aerthera is SST-registered.
RECEIPT_SST_ENABLED=false
RECEIPT_SST_NUMBER=
# Optional if AI_GATEWAY_API_KEY is set (defaults to openai/gpt-5.2 via gateway)
SOCIAL_AGENT_MODEL=
AI_GATEWAY_API_KEY=
CRON_SECRET=
# Playwright E2E (optional overrides)
# E2E_ADMIN_PASSWORD=
# E2E_SOCIAL_FULL=1 runs live AI + Meta test (slow)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
# Page access token (expires; short-lived ~1–2h, long-lived ~60d—refresh in Vercel when Meta says expired)
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Public https origin Meta uses for Instagram images / link posts when NEXT_PUBLIC_SITE_URL is localhost
META_PUBLIC_SITE_URL=
META_USER_ACCESS_TOKEN=
# Meta Marketing API / paid ads. Ads are created PAUSED by default.
META_AD_ACCOUNT_ID=
META_AD_ACCESS_TOKEN=
META_AD_DAILY_BUDGET_MINOR=1000
META_AD_COUNTRIES=MY
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
DHL_ECOMMERCE_ENV=production
DHL_ECOMMERCE_CLIENT_ID=
DHL_ECOMMERCE_PASSWORD=
DHL_ECOMMERCE_CUSTOMER_ACCOUNT_ID=
DHL_ECOMMERCE_PICKUP_ACCOUNT_ID=
DHL_ECOMMERCE_SOLD_TO_ACCOUNT_ID=
DHL_ECOMMERCE_PRODUCT_CODE=
DHL_ECOMMERCE_SHIPMENT_ID_PREFIX=
DHL_ECOMMERCE_LABEL_FORMAT=PDF
DHL_ECOMMERCE_MESSAGE_SOURCE=AERTHERA
DHL_ECOMMERCE_TRACKING_URL=https://ecommerceportal.dhl.com/track/
DHL_ECOMMERCE_PICKUP_COMPANY=
DHL_ECOMMERCE_PICKUP_NAME=
DHL_ECOMMERCE_PICKUP_ADDRESS1=
DHL_ECOMMERCE_PICKUP_ADDRESS2=
DHL_ECOMMERCE_PICKUP_ADDRESS3=
DHL_ECOMMERCE_PICKUP_CITY=
DHL_ECOMMERCE_PICKUP_STATE=
DHL_ECOMMERCE_PICKUP_DISTRICT=
DHL_ECOMMERCE_PICKUP_POSTCODE=
DHL_ECOMMERCE_PICKUP_COUNTRY=MY
DHL_ECOMMERCE_PICKUP_PHONE=
DHL_ECOMMERCE_PICKUP_EMAIL=
DHL_ECOMMERCE_SHIPPER_COMPANY=
DHL_ECOMMERCE_SHIPPER_NAME=
DHL_ECOMMERCE_SHIPPER_ADDRESS1=
DHL_ECOMMERCE_SHIPPER_ADDRESS2=
DHL_ECOMMERCE_SHIPPER_ADDRESS3=
DHL_ECOMMERCE_SHIPPER_CITY=
DHL_ECOMMERCE_SHIPPER_STATE=
DHL_ECOMMERCE_SHIPPER_DISTRICT=
DHL_ECOMMERCE_SHIPPER_POSTCODE=
DHL_ECOMMERCE_SHIPPER_COUNTRY=MY
DHL_ECOMMERCE_SHIPPER_PHONE=
DHL_ECOMMERCE_SHIPPER_EMAIL=

# --- Staff sign-up (off by default) ---------------------------------------
# When "true", /join renders a public application form. Applications are always
# created pending: they cannot log in until an admin approves them and picks
# what type of staff they are. Leave unset while one person runs the shop.
STAFF_SELF_REGISTRATION=false
# Shared secret in the join link (/join?code=...). Without it /join is a 404,
# so a leaked URL alone is not enough to reach the form.
STAFF_INVITE_CODE=
